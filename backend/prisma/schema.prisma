generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Module: Master Data Configuration (V2.0) ──

model MasterDataItem {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, isActive])
  @@map("master_data_items")
}

model MasterCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(50)
  parentId    String?  @map("parent_id") @db.Uuid
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent          MasterCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        MasterCategory[] @relation("CategoryTree")
  budgetCategories BudgetCategory[] @relation("MasterCategoryBudget")
  actualCosts     ActualCost[]     @relation("MasterCategoryCosts")
  hardwareAssets  HardwareAsset[]  @relation("MasterCategoryHardware")

  @@index([type, isActive])
  @@index([parentId])
  @@map("master_categories")
}

// ── Module: Dynamic RBAC (V2.0) ──

model DynamicRole {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]           @relation("UserDynamicRole")

  @@map("dynamic_roles")
}

model RolePermission {
  id         String  @id @default(uuid()) @db.Uuid
  roleId     String  @map("role_id") @db.Uuid
  module     String  @db.VarChar(50)
  canView    Boolean @default(false) @map("can_view")
  canCreate  Boolean @default(false) @map("can_create")
  canEdit    Boolean @default(false) @map("can_edit")
  canDelete  Boolean @default(false) @map("can_delete")
  canExport  Boolean @default(false) @map("can_export")
  canImport  Boolean @default(false) @map("can_import")
  canApprove Boolean @default(false) @map("can_approve")

  role DynamicRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
  @@map("role_permissions")
}

// ── Module: Authentication & Users ──

enum UserRole {
  admin
  manager
  staff
  finance
  viewer
}

enum UserStatus {
  active
  locked
  inactive
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  fullName       String     @map("full_name") @db.VarChar(255)
  email          String     @unique @db.VarChar(255)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  role           UserRole   @default(staff)
  dynamicRoleId  String?    @map("dynamic_role_id") @db.Uuid  // V2.0: FK to DynamicRole
  status         UserStatus @default(active)
  twoFaSecret    String?    @map("two_fa_secret") @db.VarChar(255)
  twoFaEnabled   Boolean    @default(false) @map("two_fa_enabled")
  department     String?    @db.VarChar(100)
  phone          String?    @db.VarChar(20)
  avatarUrl      String?    @map("avatar_url") @db.VarChar(500)
  lastLoginAt    DateTime?  @map("last_login_at")
  failedAttempts Int        @default(0) @map("failed_attempts")
  lockedUntil    DateTime?  @map("locked_until")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  dynamicRole    DynamicRole? @relation("UserDynamicRole", fields: [dynamicRoleId], references: [id])
  auditLogs      AuditLog[]
  createdPlans   BudgetPlan[] @relation("CreatedPlans")
  approvedPlans  BudgetPlan[] @relation("ApprovedPlans")
  createdCosts   ActualCost[] @relation("CreatedCosts")
  createdVendors Vendor[]     @relation("CreatedVendors")
  createdContracts Contract[] @relation("CreatedContracts")
  uploadedAttachments ContractAttachment[] @relation("UploadedAttachments")
  notifications  Notification[] @relation("UserNotifications")
  createdEmails  EmailAccount[]     @relation("CreatedEmails")
  createdDomains Domain[]           @relation("CreatedDomains")
  createdVps     VpsServer[]        @relation("CreatedVps")
  createdLicenses SoftwareLicense[] @relation("CreatedLicenses")
  createdSsl     SslCertificate[]   @relation("CreatedSsl")
  createdHardware HardwareAsset[]   @relation("CreatedHardware")
  createdInfra    InfraResource[]   @relation("CreatedInfra")
  createdIps      IpAddress[]       @relation("CreatedIps")
  createdVehicles Vehicle[]         @relation("CreatedVehicles")
  createdVehicleCosts VehicleVariableCost[] @relation("CreatedVehicleCosts")
  createdSubscriptions VehicleServiceSubscription[] @relation("CreatedSubscriptions")
  createdProjects Project[]         @relation("CreatedProjects")
  createdForecasts CostForecast[]   @relation("CreatedForecasts")
  approvedForecasts CostForecast[]  @relation("ApprovedForecasts")
  forecastHistory CostForecastHistory[] @relation("ForecastHistoryPerformer")
  createdForecastItems CostForecastItem[] @relation("CreatedForecastItems")
  uploadedFiles FileUpload[] @relation("UploadedFiles")
  createdPayments ContractPayment[] @relation("CreatedPayments")
  uploadedCostAttachments CostAttachment[] @relation("UploadedCostAttachments")
  planHistoryChanges BudgetPlanHistory[] @relation("PlanHistoryChanges")
  licenseAssignments LicenseAssignment[] @relation("LicenseUser")
  licenseAssignedBy LicenseAssignment[] @relation("LicenseAssigner")
  assetAssignedBy AssetAssignment[] @relation("AssetAssigner")
  maintenanceCreated AssetMaintenanceLog[] @relation("MaintenanceCreator")
  reconciliationsConfirmed VendorReconciliation[] @relation("ReconciliationConfirmer")

  @@index([dynamicRoleId])
  @@map("users")
}

// ── Module: Audit Log ──

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  module     String   @db.VarChar(50)
  action     String   @db.VarChar(20)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([module, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Module: Budget Planning ──

enum BudgetStatus {
  draft
  pending
  approved
  rejected
}

model BudgetPlan {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(20)
  name          String       @db.VarChar(255)
  year          Int
  quarter       Int?
  description   String?      @db.Text
  totalAmount   Decimal      @default(0) @map("total_amount") @db.Decimal(18, 2)
  status        BudgetStatus @default(draft)
  version       Int          @default(1)
  rejectionNote String?      @map("rejection_note") @db.Text
  createdById   String       @map("created_by") @db.Uuid
  approvedById  String?      @map("approved_by") @db.Uuid
  approvedAt    DateTime?    @map("approved_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  createdBy  User               @relation("CreatedPlans", fields: [createdById], references: [id])
  approvedBy User?              @relation("ApprovedPlans", fields: [approvedById], references: [id])
  categories BudgetCategory[]
  history    BudgetPlanHistory[]

  @@index([year, status])
  @@index([createdById])
  @@map("budget_plans")
}

model BudgetCategory {
  id               String @id @default(uuid()) @db.Uuid
  planId           String @map("plan_id") @db.Uuid
  name             String @db.VarChar(255)
  masterCategoryId String? @map("master_category_id") @db.Uuid  // V2.0: FK to MasterCategory
  sortOrder        Int   @default(0) @map("sort_order")

  plan           BudgetPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  masterCategory MasterCategory? @relation("MasterCategoryBudget", fields: [masterCategoryId], references: [id])
  items          BudgetItem[]

  @@index([planId])
  @@index([masterCategoryId])
  @@map("budget_categories")
}

model BudgetItem {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  unit        String? @db.VarChar(50)
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(18, 2)
  totalPrice  Decimal @default(0) @map("total_price") @db.Decimal(18, 2)
  note        String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")
  projectId   String? @map("project_id") @db.Uuid

  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id])
  actualCosts ActualCost[]

  @@index([categoryId])
  @@index([projectId])
  @@map("budget_items")
}

// ── Module: Cost Management ──

enum PaymentStatus {
  pending
  partial_paid  // V2.0: Thanh toán một phần
  paid
  cancelled
}

model ActualCost {
  id               String         @id @default(uuid()) @db.Uuid
  budgetItemId     String?        @map("budget_item_id") @db.Uuid
  categoryName     String         @map("category_name") @db.VarChar(255)
  masterCategoryId String?        @map("master_category_id") @db.Uuid  // V2.0
  description      String         @db.Text
  amount           Decimal        @db.Decimal(18, 2)
  paidAmount       Decimal?       @map("paid_amount") @db.Decimal(18, 2)  // V2.0: Đã thanh toán
  costDate         DateTime       @map("cost_date") @db.Date
  paymentDueDate   DateTime?      @map("payment_due_date") @db.Date  // V2.0: Hạn thanh toán
  vendor           String?        @db.VarChar(255)
  vendorId         String?        @map("vendor_id") @db.Uuid
  contractId       String?        @map("contract_id") @db.Uuid
  invoiceNo        String?        @map("invoice_no") @db.VarChar(100)
  poNumber         String?        @map("po_number") @db.VarChar(100)
  paymentStatus    PaymentStatus  @default(pending) @map("payment_status")
  paidAt           DateTime?      @map("paid_at") @db.Date
  note             String?        @db.Text
  createdById      String         @map("created_by") @db.Uuid
  projectId        String?        @map("project_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  budgetItem      BudgetItem?     @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  masterCategory  MasterCategory? @relation("MasterCategoryCosts", fields: [masterCategoryId], references: [id])
  createdBy       User            @relation("CreatedCosts", fields: [createdById], references: [id])
  project         Project?        @relation(fields: [projectId], references: [id])
  vendorRef       Vendor?         @relation("VendorCosts", fields: [vendorId], references: [id])
  contractRef     Contract?       @relation("ContractCosts", fields: [contractId], references: [id])
  attachments     CostAttachment[]

  @@index([costDate])
  @@index([budgetItemId])
  @@index([createdById])
  @@index([categoryName])
  @@index([masterCategoryId])
  @@index([projectId])
  @@index([vendorId])
  @@index([contractId])
  @@index([paymentStatus])
  @@index([paymentDueDate])
  @@map("actual_costs")
}

// ── Module: Project Budget ──

enum ProjectStatus {
  active
  closed
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(255)
  description String?       @db.Text
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  department  String?       @db.VarChar(100)
  status      ProjectStatus @default(active)
  notes       String?       @db.Text
  createdById String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy   User          @relation("CreatedProjects", fields: [createdById], references: [id])
  budgetItems BudgetItem[]
  actualCosts ActualCost[]
  forecastItems CostForecastItem[]

  @@index([status])
  @@index([createdById])
  @@map("projects")
}

// ── Module: Vendor & Contract Management ──

enum VendorStatus {
  active
  inactive
}

model Vendor {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(20)
  name         String       @db.VarChar(255)
  taxCode      String?      @unique @map("tax_code") @db.VarChar(20)
  email        String?      @db.VarChar(255)
  phone        String?      @db.VarChar(20)
  address      String?      @db.Text
  website      String?      @db.VarChar(255)
  category     String?      @db.VarChar(100)
  contactName  String?      @map("contact_name") @db.VarChar(255)
  contactPhone String?      @map("contact_phone") @db.VarChar(20)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  bankName     String?      @map("bank_name") @db.VarChar(255)
  bankAccount  String?      @map("bank_account") @db.VarChar(50)
  bankBranch   String?      @map("bank_branch") @db.VarChar(255)
  status       VendorStatus @default(active)
  note         String?      @db.Text
  createdById  String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  createdBy User       @relation("CreatedVendors", fields: [createdById], references: [id])
  contracts Contract[]
  emailAccounts    EmailAccount[]     @relation("VendorEmails")
  domains          Domain[]           @relation("VendorDomains")
  vpsServers       VpsServer[]        @relation("VendorVps")
  softwareLicenses SoftwareLicense[]  @relation("VendorLicenses")
  sslCertificates  SslCertificate[]   @relation("VendorSsl")
  hardwareAssets   HardwareAsset[]    @relation("VendorHardware")
  infraResources   InfraResource[]    @relation("VendorInfra")
  vehicles         Vehicle[]          @relation("VendorVehicles")
  actualCosts      ActualCost[]       @relation("VendorCosts")
  forecastItems    CostForecastItem[] @relation("VendorForecasts")
  reconciliations  VendorReconciliation[] @relation("VendorReconciliations")

  @@index([status])
  @@index([createdById])
  @@index([name])
  @@map("vendors")
}

// ── Module: Vendor Accounts Payable (V2.0) ──

model VendorReconciliation {
  id                 String   @id @default(uuid()) @db.Uuid
  vendorId           String   @map("vendor_id") @db.Uuid
  reconciliationDate DateTime @map("reconciliation_date") @db.Date
  totalOutstanding   Decimal  @map("total_outstanding") @db.Decimal(18, 2)
  totalPaid          Decimal  @map("total_paid") @db.Decimal(18, 2)
  confirmedBy        String   @map("confirmed_by") @db.Uuid
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  vendor    Vendor @relation("VendorReconciliations", fields: [vendorId], references: [id])
  confirmer User   @relation("ReconciliationConfirmer", fields: [confirmedBy], references: [id])
  items     VendorReconciliationItem[]

  @@index([vendorId, reconciliationDate])
  @@map("vendor_reconciliations")
}

model VendorReconciliationItem {
  id               String  @id @default(uuid()) @db.Uuid
  reconciliationId String  @map("reconciliation_id") @db.Uuid
  actualCostId     String  @map("actual_cost_id") @db.Uuid
  amount           Decimal @db.Decimal(18, 2)
  status           String  @db.VarChar(20)
  note             String? @db.Text

  reconciliation VendorReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@map("vendor_reconciliation_items")
}

enum ContractStatus {
  draft
  active
  expired
  terminated
}

model Contract {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(30)
  name        String         @db.VarChar(255)
  vendorId    String         @map("vendor_id") @db.Uuid
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  value       Decimal        @default(0) @db.Decimal(18, 2)
  status      ContractStatus @default(draft)
  contractType String?       @map("contract_type") @db.VarChar(50)
  signDate   DateTime?       @map("sign_date") @db.Date
  autoRenew  Boolean         @default(false) @map("auto_renew")
  alertDays  Int             @default(30) @map("alert_days")
  description String?        @db.Text
  terms       String?        @db.Text
  createdById String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  vendor      Vendor               @relation(fields: [vendorId], references: [id])
  createdBy   User                 @relation("CreatedContracts", fields: [createdById], references: [id])
  attachments ContractAttachment[]
  payments         ContractPayment[]  @relation("ContractPayments")
  costs            ActualCost[]       @relation("ContractCosts")
  emailAccounts    EmailAccount[]     @relation("ContractEmails")
  domains          Domain[]           @relation("ContractDomains")
  vpsServers       VpsServer[]        @relation("ContractVps")
  softwareLicenses SoftwareLicense[]  @relation("ContractLicenses")
  sslCertificates  SslCertificate[]   @relation("ContractSsl")
  hardwareAssets   HardwareAsset[]    @relation("ContractHardware")
  vehicles         Vehicle[]          @relation("ContractVehicles")

  @@index([vendorId])
  @@index([status])
  @@index([endDate])
  @@index([createdById])
  @@index([name])
  @@map("contracts")
}

model ContractAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  storageKey String   @map("storage_key") @db.VarChar(500)
  uploadedById String @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([contractId])
  @@map("contract_attachments")
}

model ContractPayment {
  id          String        @id @default(uuid()) @db.Uuid
  contractId  String        @map("contract_id") @db.Uuid
  amount      Decimal       @db.Decimal(18, 2)
  paymentDate DateTime      @map("payment_date") @db.Date
  method      String?       @db.VarChar(50)
  reference   String?       @db.VarChar(100)
  note        String?       @db.Text
  createdById String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  contract Contract @relation("ContractPayments", fields: [contractId], references: [id])
  createdBy User    @relation("CreatedPayments", fields: [createdById], references: [id])

  @@index([contractId])
  @@index([paymentDate])
  @@map("contract_payments")
}

model CostAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  actualCostId String   @map("actual_cost_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  storageKey   String   @map("storage_key") @db.VarChar(500)
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  actualCost ActualCost @relation(fields: [actualCostId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("UploadedCostAttachments", fields: [uploadedById], references: [id])

  @@index([actualCostId])
  @@map("cost_attachments")
}

// ── Module: Notifications ──

enum NotificationType {
  contract_expiry
  budget_approval
  payment_overdue  // V2.0: Cảnh báo quá hạn thanh toán
  system
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(system)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  entityType String?         @map("entity_type") @db.VarChar(50)
  entityId  String?          @map("entity_id") @db.Uuid
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ── Module: File Uploads ──

model FileUpload {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  storageKey   String   @map("storage_key") @db.VarChar(500)
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy   User     @relation("UploadedFiles", fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@map("file_uploads")
}

// ── Module: Soft Inventory ──

enum SoftAssetStatus {
  active
  inactive
  expired
}

enum LicenseType {
  perpetual
  subscription
  trial
  oem
}

enum SslType {
  DV
  OV
  EV
  wildcard
}

model EmailAccount {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique @db.VarChar(255)
  provider      String          @db.VarChar(100)
  displayName   String?         @map("display_name") @db.VarChar(255)
  department    String?         @db.VarChar(100)
  plan          String?         @db.VarChar(100)
  quotaMb       Int             @default(5120) @map("quota_mb")
  usedMb        Int             @default(0) @map("used_mb")
  assignedTo    String?         @map("assigned_to") @db.VarChar(255)
  costPerYear   Decimal?        @map("cost_per_year") @db.Decimal(18, 2)
  expireDate    DateTime?       @map("expire_date") @db.Date
  status        SoftAssetStatus @default(active)
  notes         String?         @db.Text
  vendorId      String?         @map("vendor_id") @db.Uuid
  contractId    String?         @map("contract_id") @db.Uuid
  createdById   String          @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  createdBy     User            @relation("CreatedEmails", fields: [createdById], references: [id])
  vendor        Vendor?         @relation("VendorEmails", fields: [vendorId], references: [id])
  contract      Contract?       @relation("ContractEmails", fields: [contractId], references: [id])

  @@index([status])
  @@index([provider])
  @@index([vendorId])
  @@index([contractId])
  @@map("email_accounts")
}

model Domain {
  id               String          @id @default(uuid()) @db.Uuid
  domain           String          @unique @db.VarChar(255)
  registrar        String?         @db.VarChar(100)
  nameservers      String?         @db.Text
  registrationDate DateTime?       @map("registration_date")
  expiryDate       DateTime?       @map("expiry_date")
  autoRenew        Boolean         @default(false) @map("auto_renew")
  status           SoftAssetStatus @default(active)
  notes            String?         @db.Text
  vendorId         String?         @map("vendor_id") @db.Uuid
  contractId       String?         @map("contract_id") @db.Uuid
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
