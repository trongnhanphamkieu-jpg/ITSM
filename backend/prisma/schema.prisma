// ── Module: Hard Inventory ──

enum HardAssetStatus {
  in_use
  available
  maintenance
  disposed
}

enum InfraType {
  switch
  router
  firewall
  access_point
  ups
  pdu
  cable_tray
  rack
  other
}

enum IpType {
  static
  dhcp
  reserved
}

model HardwareAsset {
  id               String          @id @default(uuid()) @db.Uuid
  assetTag         String          @unique @map("asset_tag") @db.VarChar(50)
  name             String          @db.VarChar(255)
  category         String          @db.VarChar(100)
  masterCategoryId String?         @map("master_category_id") @db.Uuid  // V2.0
  brand            String?         @db.VarChar(100)
  model            String?         @db.VarChar(100)
  serialNumber     String?         @map("serial_number") @db.VarChar(100)
  specs            Json?           @db.JsonB
  purchaseDate     DateTime?       @map("purchase_date")
  warrantyExpiry   DateTime?       @map("warranty_expiry")
  location         String?         @db.VarChar(255)
  assignedTo       String?         @map("assigned_to") @db.VarChar(255)
  cost             Decimal?        @db.Decimal(18, 2)
  status           HardAssetStatus @default(available)
  notes            String?         @db.Text
  vendorId         String?         @map("vendor_id") @db.Uuid
  contractId       String?         @map("contract_id") @db.Uuid
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  masterCategory MasterCategory? @relation("MasterCategoryHardware", fields: [masterCategoryId], references: [id])
  createdBy      User            @relation("CreatedHardware", fields: [createdById], references: [id])
  vendor         Vendor?         @relation("VendorHardware", fields: [vendorId], references: [id])
  contract       Contract?       @relation("ContractHardware", fields: [contractId], references: [id])
  assignments    AssetAssignment[]
  maintenanceLogs AssetMaintenanceLog[]

  @@index([status])
  @@index([category])
  @@index([masterCategoryId])
  @@index([warrantyExpiry])
  @@index([vendorId])
  @@index([contractId])
  @@map("hardware_assets")
}

model InfraResource {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(255)
  infraType      InfraType       @default(other) @map("infra_type")
  brand          String?         @db.VarChar(100)
  model          String?         @db.VarChar(100)
  serialNumber   String?         @map("serial_number") @db.VarChar(100)
  location       String?         @db.VarChar(255)
  rackUnit       String?         @map("rack_unit") @db.VarChar(20)
  specs          Json?           @db.JsonB
  ipAddress      String?         @map("ip_address") @db.VarChar(45)
  managementUrl  String?         @map("management_url") @db.VarChar(500)
  status         HardAssetStatus @default(available)
  notes          String?         @db.Text
  vendorId       String?         @map("vendor_id") @db.Uuid
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  createdBy      User            @relation("CreatedInfra", fields: [createdById], references: [id])
  vendor         Vendor?         @relation("VendorInfra", fields: [vendorId], references: [id])

  @@index([infraType])
  @@index([status])
  @@index([vendorId])
  @@map("infra_resources")
}

model IpAddress {
  id             String          @id @default(uuid()) @db.Uuid
  address        String          @unique @db.VarChar(45)
  subnet         String?         @db.VarChar(18)
  gateway        String?         @db.VarChar(45)
  vlan           String?         @db.VarChar(20)
  ipType         IpType          @default(static) @map("ip_type")
  assignedTo     String?         @map("assigned_to") @db.VarChar(255)
  assignedType   String?         @map("assigned_type") @db.VarChar(50)
  status         HardAssetStatus @default(available)
  notes          String?         @db.Text
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  createdBy      User            @relation("CreatedIps", fields: [createdById], references: [id])

  @@index([vlan])
  @@index([status])
  @@index([ipType])
  @@map("ip_addresses")
}

// ── Module: Vehicle Cost Management ──

enum VehicleStatus {
  active
  maintenance
  disposed
}

enum CostFrequency {
  monthly
  quarterly
  yearly
  one_time
}

model Vehicle {
  id             String         @id @default(uuid()) @db.Uuid
  licensePlate   String         @unique @map("license_plate") @db.VarChar(20)
  brand          String         @db.VarChar(100)
  model          String         @db.VarChar(100)
  year           Int?
  type           String?        @db.VarChar(50)
  fuelType       String?        @map("fuel_type") @db.VarChar(30)
  color          String?        @db.VarChar(30)
  vin            String?        @db.VarChar(50)
  mileage        Int?           @default(0)
  status         VehicleStatus  @default(active)
  assignedTo     String?        @map("assigned_to") @db.VarChar(255)
  insuranceExpiry DateTime?     @map("insurance_expiry")
  registrationExpiry DateTime?  @map("registration_expiry")
  cost           Decimal?       @db.Decimal(18, 2)
  notes          String?        @db.Text
  vendorId       String?        @map("vendor_id") @db.Uuid
  contractId     String?        @map("contract_id") @db.Uuid
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  createdBy      User           @relation("CreatedVehicles", fields: [createdById], references: [id])
  vendor         Vendor?        @relation("VendorVehicles", fields: [vendorId], references: [id])
  contract       Contract?      @relation("ContractVehicles", fields: [contractId], references: [id])
  subscriptions  VehicleServiceSubscription[] @relation("VehicleSubscriptions")
  variableCosts  VehicleVariableCost[] @relation("VehicleCosts")

  @@index([status])
  @@index([licensePlate])
  @@index([contractId])
  @@map("vehicles")
}

model VehicleService {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(255)
  description    String?        @db.Text
  costType       String         @default("fixed") @map("cost_type") @db.VarChar(20)
  frequency      CostFrequency  @default(monthly)
  defaultCost    Decimal?       @map("default_cost") @db.Decimal(15, 2)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  subscriptions  VehicleServiceSubscription[] @relation("ServiceSubscriptions")
  variableCosts  VehicleVariableCost[] @relation("ServiceCosts")

  @@map("vehicle_services")
}

model VehicleVariableCost {
  id               String          @id @default(uuid()) @db.Uuid
  vehicleId        String          @map("vehicle_id") @db.Uuid
  serviceId        String          @map("service_id") @db.Uuid
  amount           Decimal         @db.Decimal(15, 2)
  date             DateTime        @db.Date
  mileageAtService Int?            @map("mileage_at_service")
  notes            String?         @db.Text
  receiptUrl       String?         @map("receipt_url") @db.VarChar(500)
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  vehicle          Vehicle         @relation("VehicleCosts", fields: [vehicleId], references: [id])
  service          VehicleService  @relation("ServiceCosts", fields: [serviceId], references: [id])
  createdBy        User            @relation("CreatedVehicleCosts", fields: [createdById], references: [id])

  @@index([vehicleId])
  @@index([serviceId])
  @@index([date])
  @@map("vehicle_variable_costs")
}

model VehicleServiceSubscription {
  id             String         @id @default(uuid()) @db.Uuid
  vehicleId      String         @map("vehicle_id") @db.Uuid
  serviceId      String         @map("service_id") @db.Uuid
  monthlyCost    Decimal        @map("monthly_cost") @db.Decimal(15, 2)
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  isActive       Boolean        @default(true) @map("is_active")
  notes          String?        @db.Text
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  vehicle        Vehicle        @relation("VehicleSubscriptions", fields: [vehicleId], references: [id])
  service        VehicleService @relation("ServiceSubscriptions", fields: [serviceId], references: [id])
  createdBy      User           @relation("CreatedSubscriptions", fields: [createdById], references: [id])

  @@index([vehicleId])
  @@index([serviceId])
  @@index([isActive])
  @@map("vehicle_service_subscriptions")
}

// ── Module: Cost Forecast ──

enum ForecastStatus {
  draft
  pending
  approved
  rejected
  closed
}

enum ForecastPriority {
  critical
  high
  medium
  low
}

model CostForecast {
  id            String         @id @default(uuid()) @db.Uuid
  year          Int
  month         Int
  name          String         @db.VarChar(255)
  totalAmount   Decimal        @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency      String         @default("VND") @db.VarChar(10)
  status        ForecastStatus @default(draft)
  approvedById  String?        @map("approved_by") @db.Uuid
  approvedAt    DateTime?      @map("approved_at")
  rejectReason  String?        @map("reject_reason") @db.Text
  notes         String?        @db.Text
  createdById   String         @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  approvedBy    User?          @relation("ApprovedForecasts", fields: [approvedById], references: [id])
  createdBy     User           @relation("CreatedForecasts", fields: [createdById], references: [id])
  items         CostForecastItem[]
  history       CostForecastHistory[]

  @@unique([year, month])
  @@index([status])
  @@index([createdById])
  @@map("cost_forecasts")
}

model CostForecastItem {
  id              String           @id @default(uuid()) @db.Uuid
  forecastId      String           @map("forecast_id") @db.Uuid
  itemName        String           @map("item_name") @db.VarChar(255)
  description     String?          @db.Text
  estimatedAmount Decimal          @map("estimated_amount") @db.Decimal(18, 2)
  vendor          String?          @db.VarChar(255)
  vendorId        String?          @map("vendor_id") @db.Uuid
  projectId       String?          @map("project_id") @db.Uuid
  priority        ForecastPriority @default(medium)
  notes           String?          @db.Text
  sortOrder       Int              @default(0) @map("sort_order")
  createdById     String           @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  forecast        CostForecast     @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id])
  createdBy       User             @relation("CreatedForecastItems", fields: [createdById], references: [id])
  vendorRef       Vendor?          @relation("VendorForecasts", fields: [vendorId], references: [id])

  @@index([forecastId])
  @@index([projectId])
  @@map("cost_forecast_items")
}

model CostForecastHistory {
  id            String       @id @default(uuid()) @db.Uuid
  forecastId    String       @map("forecast_id") @db.Uuid
  action        String       @db.VarChar(50)
  comment       String?      @db.Text
  performedById String       @map("performed_by") @db.Uuid
  performedAt   DateTime     @default(now()) @map("performed_at")

  forecast      CostForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  performedBy   User         @relation("ForecastHistoryPerformer", fields: [performedById], references: [id])

  @@index([forecastId])
  @@map("cost_forecast_history")
}

// ── Module: Version Tracking ──

model BudgetPlanHistory {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  version     Int
  snapshot    Json     @db.JsonB
  changedById String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at")

  plan      BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changedBy User       @relation("PlanHistoryChanges", fields: [changedById], references: [id])

  @@index([planId, version])
  @@map("budget_plan_history")
}

// ── Module: Assignment Tracking ──

model LicenseAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  licenseId   String    @map("license_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  revokedAt   DateTime? @map("revoked_at")
  assignedById String   @map("assigned_by") @db.Uuid

  license    SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user       User            @relation("LicenseUser", fields: [userId], references: [id])
  assignedBy User            @relation("LicenseAssigner", fields: [assignedById], references: [id])

  @@index([licenseId])
  @@index([userId])
  @@map("license_assignments")
}

model AssetAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  assignedTo  String    @map("assigned_to") @db.VarChar(255)
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  returnedAt  DateTime? @map("returned_at")
  assignedById String   @map("assigned_by") @db.Uuid
  note        String?   @db.Text

  asset      HardwareAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedBy User          @relation("AssetAssigner", fields: [assignedById], references: [id])

  @@index([assetId])
  @@map("asset_assignments")
}

model AssetMaintenanceLog {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  type        String    @db.VarChar(50)
  description String    @db.Text
  cost        Decimal?  @db.Decimal(18, 2)
  performedAt DateTime  @map("performed_at") @db.Date
  performedBy String?   @map("performed_by") @db.VarChar(255)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  asset     HardwareAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User          @relation("MaintenanceCreator", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([performedAt])
  @@map("asset_maintenance_logs")
}
