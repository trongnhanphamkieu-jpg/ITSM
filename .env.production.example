# ── ITMS Production Environment ──
# Copy to .env and fill in values

# Database
DB_NAME=itms
DB_USER=postgres
DB_PASS=CHANGE_ME_strong_password_here

# JWT (REQUIRED)
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# Frontend URL (for CORS)
FRONTEND_URL=https://itms.haivan.com

# Redis
REDIS_PASS=CHANGE_ME_redis_password

# MinIO (File Storage)
MINIO_ACCESS_KEY=CHANGE_ME_minio_access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
