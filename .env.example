# ── App ─────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database ────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itms

# ── Redis ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────
JWT_SECRET=your-256-bit-secret-change-this
JWT_REFRESH_SECRET=your-separate-refresh-secret-change-this
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

# ── MinIO / S3 ──────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=itms-files
MINIO_USE_SSL=false

# ── SMTP (Email) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itms@company.com
SMTP_PASS=app-password
SMTP_FROM="ITMS System <itms@company.com>"

# ── Misc ────────────────────────────
LOG_RETENTION_MONTHS=12
RATE_LIMIT_PER_MINUTE=100
MAX_FILE_SIZE_MB=10
